APP_NAME="VA Workspace"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
# DB app (ServBay). PHPUnit dùng DB riêng `va_workspace_db_test` (phpunit.xml) —
# tạo: CREATE DATABASE va_workspace_db_test CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=
DB_PREFIX=va_workspace_

BROADCAST_DRIVER=reverb
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120
# Production (HTTPS sau reverse proxy) BẮT BUỘC set 2 dòng dưới, nếu không
# cookie session có thể không được gửi lại đúng giữa lúc redirect ra Google
# và lúc callback quay về → lỗi giả "Phiên đăng nhập đã hết hạn"
# (InvalidStateException) dù thao tác đăng nhập đúng.
#   SESSION_DOMAIN=.vaschools.edu.vn
#   SESSION_SECURE_COOKIE=true
# Nhiều máy chủ (load balancer): dùng SESSION_DRIVER=redis hoặc database.

# SPA cùng origin (Blade @vite mount Vue) nên không cần domain thứ 2 ở đây,
# chỉ thêm host dev khi chạy `npm run dev` (Vite dev server) song song.
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:5173,workspace.vaschools.edu.vn
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Google Workspace SSO (đăng nhập Google) — Modules/Identity. KHÔNG còn được
# route tới (thay bằng VA-HRM SSO bên dưới), giữ lại để tham khảo/rollback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_DOMAINS=vaschools.edu.vn
GOOGLE_REDIRECT_URI=/auth/google/callback

# VA-HRM SSO + đồng bộ nhân sự (Modules/Identity/App/Hrm) — thay thế đăng
# nhập Google. HRM_SSO_CALLBACK_URL phải khớp TUYỆT ĐỐI (byte-for-byte) với
# 1 phần tử redirect_uris của ApiClient đăng ký bên HRM cho va-workspace.
# Origin HRM (không kèm /api/v1). VD: https://hrm.vaschools.edu.vn — SSO redirect
# tới {HRM_API_BASE_URL}/sso/authorize; API client gọi {base}/api/v1/...
HRM_API_BASE_URL=
# Bearer ApiClient va-workspace trên HRM — cần abilities employees:read, org:read;
# nếu HRM chưa có JWKS, thêm ability cho POST /api/v1/auth/verify-token.
# Sau khi admin HRM bổ sung ability: tạo lại token ApiClient và cập nhật env
# (token cũ thường không mang quyền mới). Chẩn đoán: php artisan identity:hrm-sso-diagnose
HRM_API_TOKEN=
# Catalog + số dư + gửi đơn nghỉ (GET /api/v1/leave/types|balances, POST /api/v1/leave/requests) — portal HRM; token cần leave:read + leave:write.
# HRM_LEAVE_API_BASE_URL=https://portal.hrm.vaschools.edu.vn
# HRM_LEAVE_API_TOKEN=
HRM_SSO_CLIENT_ID=va-workspace
HRM_SSO_ISSUER=
HRM_SSO_CALLBACK_URL={APP_URL}/auth/hrm/callback
# JWKS offline (mặc định). Nếu HRM chưa publish endpoint, workspace fallback
# POST /api/v1/auth/verify-token khi có HRM_API_TOKEN.
# HRM_JWKS_PATH=/.well-known/jwks.json
HRM_JWKS_CACHE_TTL=21600
# TLS: true (mặc định) | false (chỉ debug) | /path/to/ca-bundle.pem nếu cert HRM
# dùng CA nội bộ và curl/PHP báo "unable to get local issuer certificate".
# HRM_HTTP_VERIFY=true
# Secret HMAC cấu hình khi admin HRM tạo webhook subscription (đăng ký tại
# {HRM_API_BASE_URL}/admin/api-clients/{uuid}/webhooks, URL:
# {APP_URL}/api/hrm/webhook, event: employee.updated/transferred/terminated,
# org_unit.changed).
HRM_WEBHOOK_SECRET=
# Bulk sync nhân viên khi mở trang nhân sự workspace (giây, mặc định 900).
# HRM_EMPLOYEE_BULK_SYNC_TTL=900
# HRM_DEPARTMENT_MANAGER_SYNC_TTL=900
# MySQL VA-HRM (đọc thẳng, không gọi API) — trang Nhân sự workspace.
# Production: database vaschools-hrm-db-stag, prefix va_hrm_, user khoanaadmin.
# HRM_DB_HOST=127.0.0.1 chỉ khi PHP workspace và MySQL HRM cùng một máy.
HRM_DB_HOST=127.0.0.1
HRM_DB_PORT=3306
HRM_DB_DATABASE=
HRM_DB_USERNAME=
HRM_DB_PASSWORD=
HRM_DB_PREFIX=va_hrm_

# Email super_admin (view-as) — phải trùng email Google SSO. Sau deploy:
#   php artisan identity:ensure-super-admin
SUPERADMIN_EMAIL=khoana@hcm.vaschools.edu.vn

# Bucket S3 dùng để lưu ảnh/tệp đính kèm bài viết & bình luận Social
# (Modules/Social/App/Services/SocialAttachmentUploader.php) — bắt buộc
# phải cấu hình đủ để tính năng đính kèm ảnh hoạt động.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
# Chỉ cần điền nếu dùng dịch vụ tương thích S3 khác AWS thật (vd. DigitalOcean
# Spaces, Wasabi, MinIO) hoặc muốn URL public đi qua CDN riêng.
AWS_URL=
AWS_ENDPOINT=
# Tiền tố thư mục trong bucket dùng riêng cho app này (bucket có thể dùng chung
# nhiều dự án). Production VA Schools: vaschools-uploads (xem docs/s3-bucket-policy.json).
S3_BASE_PATH=

# Laravel Reverb (WebSocket realtime — Modules/Chat) — chạy `php artisan
# reverb:start` như 1 process nền riêng (systemd/supervisor), tách biệt
# PHP-FPM. REVERB_HOST/PORT/SCHEME là địa chỉ client (trình duyệt) kết nối
# tới, REVERB_SERVER_HOST/PORT (config/reverb.php) là địa chỉ process lắng
# nghe thật trên server — thường khác nhau khi có Nginx proxy WebSocket.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
# Khi trang chạy HTTPS, trình duyệt bắt buộc wss. Trỏ cert local (ServBay/Herd)
# để `reverb:start` nghe TLS. Để trống thì server vẫn là ws thuần.
REVERB_TLS_CERT=
REVERB_TLS_KEY=

VITE_APP_NAME="${APP_NAME}"
# Base URL Vue gọi API khi chạy Vite dev server (port khác Laravel serve).
# Để trống khi build production cùng origin qua @vite (Blade mount) —
# tránh axios trỏ lệch origin rồi dính CSRF 419.
VITE_API_URL=
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Thông báo đẩy trình duyệt (Web Push / VAPID)
# Tạo khóa: php artisan identity:vapid-keys --write
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:workspace@vaschools.edu.vn
