APP_NAME="VA Workspace"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=
DB_PREFIX=va_workspace_

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
# Production (HTTPS sau reverse proxy) BẮT BUỘC set 2 dòng dưới, nếu không
# cookie session có thể không được gửi lại đúng giữa lúc redirect ra Google
# và lúc callback quay về → lỗi giả "Phiên đăng nhập đã hết hạn"
# (InvalidStateException) dù thao tác đăng nhập đúng.
#   SESSION_DOMAIN=.vaschools.edu.vn
#   SESSION_SECURE_COOKIE=true

# SPA cùng origin (Blade @vite mount Vue) nên không cần domain thứ 2 ở đây,
# chỉ thêm host dev khi chạy `npm run dev` (Vite dev server) song song.
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Google Workspace SSO (đăng nhập Google) — Modules/Identity
# Tạo OAuth Client tại Google Cloud Console, Authorized redirect URI:
#   {APP_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Chỉ tài khoản thuộc các domain này mới đăng nhập được (comma-separated).
GOOGLE_ALLOWED_DOMAINS=vaschools.edu.vn
GOOGLE_REDIRECT_URI=/auth/google/callback

# Email được seed sẵn làm super_admin (đủ 7 role) — Modules/Identity/Database/Seeders/SuperAdminSeeder.php
SUPERADMIN_EMAIL=khoana@hcm.vaschools.edu.vn

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
# Base URL Vue gọi API khi chạy Vite dev server (port khác Laravel serve).
VITE_API_URL=http://localhost:8000
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
