APP_NAME="VA Workspace"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
# DB app (ServBay). PHPUnit dùng DB riêng `va_workspace_db_test` (phpunit.xml) —
# tạo: CREATE DATABASE va_workspace_db_test CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=
DB_PREFIX=va_workspace_

BROADCAST_DRIVER=reverb
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120
# Production (HTTPS sau reverse proxy) BẮT BUỘC set 2 dòng dưới, nếu không
# cookie session có thể không được gửi lại đúng giữa lúc redirect ra Google
# và lúc callback quay về → lỗi giả "Phiên đăng nhập đã hết hạn"
# (InvalidStateException) dù thao tác đăng nhập đúng.
#   SESSION_DOMAIN=.vaschools.edu.vn
#   SESSION_SECURE_COOKIE=true
# Nhiều máy chủ (load balancer): dùng SESSION_DRIVER=redis hoặc database.

# SPA cùng origin (Blade @vite mount Vue) nên không cần domain thứ 2 ở đây,
# chỉ thêm host dev khi chạy `npm run dev` (Vite dev server) song song.
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:5173,workspace.vaschools.edu.vn
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Google Workspace SSO (đăng nhập Google) — Modules/Identity
# Tạo OAuth Client tại Google Cloud Console, Authorized redirect URI:
#   {APP_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Chỉ tài khoản thuộc các domain này mới đăng nhập được (comma-separated).
GOOGLE_ALLOWED_DOMAINS=vaschools.edu.vn
GOOGLE_REDIRECT_URI=/auth/google/callback

# Email super_admin (view-as) — phải trùng email Google SSO. Sau deploy:
#   php artisan identity:ensure-super-admin
SUPERADMIN_EMAIL=khoana@hcm.vaschools.edu.vn

# Bucket S3 dùng để lưu ảnh/tệp đính kèm bài viết & bình luận Social
# (Modules/Social/App/Services/SocialAttachmentUploader.php) — bắt buộc
# phải cấu hình đủ để tính năng đính kèm ảnh hoạt động.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
# Chỉ cần điền nếu dùng dịch vụ tương thích S3 khác AWS thật (vd. DigitalOcean
# Spaces, Wasabi, MinIO) hoặc muốn URL public đi qua CDN riêng.
AWS_URL=
AWS_ENDPOINT=
# Tiền tố thư mục trong bucket dùng riêng cho app này (bucket có thể dùng chung
# nhiều dự án). Production VA Schools: vaschools-uploads (xem docs/s3-bucket-policy.json).
S3_BASE_PATH=

# Laravel Reverb (WebSocket realtime — Modules/Chat) — chạy `php artisan
# reverb:start` như 1 process nền riêng (systemd/supervisor), tách biệt
# PHP-FPM. REVERB_HOST/PORT/SCHEME là địa chỉ client (trình duyệt) kết nối
# tới, REVERB_SERVER_HOST/PORT (config/reverb.php) là địa chỉ process lắng
# nghe thật trên server — thường khác nhau khi có Nginx proxy WebSocket.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_APP_NAME="${APP_NAME}"
# Base URL Vue gọi API khi chạy Vite dev server (port khác Laravel serve).
# Để trống khi build production cùng origin qua @vite (Blade mount) —
# tránh axios trỏ lệch origin rồi dính CSRF 419.
VITE_API_URL=
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Thông báo đẩy trình duyệt (Web Push / VAPID)
# Tạo khóa: php artisan identity:vapid-keys --write
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:workspace@vaschools.edu.vn
